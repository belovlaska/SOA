<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure>
    <deployment>
        <exclusions>
            <!-- Используем jakarta вместо javax -->
            <module name="jakarta.servlet.jsp.api"/>
            <module name="jakarta.servlet.jstl.api"/>
            <module name="ch.qos.logback"/>
        </exclusions>
        <!-- Явно включаем необходимые модули Jakarta -->
        <dependencies>
            <module name="jakarta.servlet.api" export="true"/>
            <module name="jakarta.annotation.api" export="true"/>
            <module name="jakarta.validation.api" export="true"/>
            <module name="jakarta.enterprise.api" export="true"/>
        </dependencies>
    </deployment>
</jboss-deployment-structure>